# Copy this file to .env.local for local development, and fill in the same
# values in the Vercel project dashboard (Settings > Environment Variables).

# Supabase project URL, e.g. https://lcggirdmbogzsoqhmbyw.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (server only - NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project ref, e.g. lcggirdmbogzsoqhmbyw
SUPABASE_PROJECT_REF=