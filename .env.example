# =====================================================================
# Environment variables
# =====================================================================
#
# COPY THIS FILE to .env.local for LOCAL DEVELOPMENT only.
# .env.local is git-ignored - never commit keys.
#
# VERCEL: only the two NEXT_PUBLIC_ vars below are required (set them in
# the Vercel dashboard as Production/Preview/Development). The other two
# are for LOCAL scripts only - do NOT add them to Vercel.

# ---- Required for deployment (Vercel) ----
# Your Supabase project URL, e.g. https://lcggirdmbogzsoqhmbyw.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public/publishable - safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Local scripts only (NEVER in Vercel, NEVER commit) ----
# Service-role key (full database access, server-side scripts)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase platform management token (start with sbp_)
SUPABASE_MGMT_TOKEN=

# Supabase project ref, e.g. lcggirdmbogzsoqhmbyw
SUPABASE_PROJECT_REF=